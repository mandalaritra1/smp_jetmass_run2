universe                = vanilla
executable              = inner_internal_variations.sh
arguments               = $(mode) $(campaign) $(bin) $(seed) $(nevt) cp5 cr1 cr2 fraghard fragsoft
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = py313/pythia_rivet, py313/RivetCMS_HADRONIC_JETMASS.so, cp5.cmnd
output                  = /dev/null
error                   = /dev/null
log                     = /dev/null
MY.SendCredential       = True
+JobFlavour             = "workday"
request_cpus            = 1
request_memory          = 3000
requirements            = (OpSysAndVer =?= "AlmaLinux9")
periodic_release        = (NumJobStarts < 4) && (HoldReasonCode =!= 1)
max_retries             = 4
queue mode,campaign,bin,seed,nevt from joblist_internal.txt


universe                = vanilla
executable              = inner_mess.sh
arguments               = $(campaign) $(bin) $(seed) $(nevt)
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = py313/pythia_rivet_mess, py313/RivetCMS_HADRONIC_JETMASS.so, cp5.cmnd
output                  = /dev/null
error                   = /dev/null
log                     = /dev/null
MY.SendCredential       = True
+JobFlavour             = "workday"
request_cpus            = 1
request_memory          = 2000
requirements            = (OpSysAndVer =?= "AlmaLinux9")
periodic_release        = (NumJobStarts < 4) && (HoldReasonCode =!= 1)
max_retries             = 4
queue campaign,bin,seed,nevt from joblist_mess.txt

universe                = vanilla
executable              = inner_hardqcd.sh
# HADCONFIGS is appended by submit_hardqcd.sh; expanded at queue time.
arguments               = $(ptlo) $(pthi) $(seed) $(nevt) $(HADCONFIGS)
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = pythia_rivet, RivetCMS_HADRONIC_JETMASS.so, cp5.cmnd
output                  = logs/$(ptlo)_$(seed).out
error                   = logs/$(ptlo)_$(seed).err
log                     = logs/diag.log
MY.SendCredential       = True
+JobFlavour             = "workday"
request_cpus            = 1
# Memory grows with events-per-process in the Pythia->HepMC->Rivet loop
# (~145 kB/event: 40k-event jobs peaked at ~5.8 GB and were held against a
# 3000 MB cgroup). Keep NEVT per config modest and request headroom.
request_memory          = $(REQMEM)
requirements            = (OpSysAndVer =?= "AlmaLinux9")
periodic_release        = (NumJobStarts < 4) && (HoldReasonCode =!= 1)
max_retries             = 4
queue ptlo,pthi,seed,nevt from joblist_diag.txt

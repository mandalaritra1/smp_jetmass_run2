# Sherpa 3 Comix MEPS@LO QCD multijet canary for the pair_split study.
# Render with scripts/render_card.py; do not run this template directly.
BEAMS: [2212, 2212]
BEAM_ENERGIES: 6500

EVENTS: __NEVENTS__
RANDOM_SEED: __SEED__

ME_GENERATORS: [Comix]

PDF_LIBRARY: LHAPDFSherpa
PDF_SET: PDF4LHC21_40_pdfas
ALPHAS:
  USE_PDF: 1

# Explicit settings: never depend on an image-level default.
SHOWER_GENERATOR: __SHOWER__
JET_CRITERION: __SHOWER__
FRAGMENTATION: Ahadic

# QCD 2->2 core plus up to two additional matrix-element partons.
PROCESSES:
- 93 93 -> 93 93 93{2}:
    Order: {QCD: 2, EW: 0}
    CKKW: 20
    Integration_Error: 0.02

# CKKW does not regularize the 2->2 core process.
SELECTORS:
- NJetFinder:
    N: 2
    PTMin: 20.0
    ETMin: 0.0
    R: 0.4
    Exp: -1

# Exclusive leading ME-level anti-kT R=0.4 jet-pT slice.  The expression is
# version-sensitive and is a mandatory syntax/closure canary gate.
- FastjetSelector:
    Expression: PPerp(p[2]) >= __PTLOW__ && PPerp(p[2]) < __PTHIGH__
    Algorithm: antikt
    N: 2
    PTMin: 20.0
    ETMin: 0.0
    DR: 0.4

EVENT_OUTPUT: HepMC3_GenEvent[events]
